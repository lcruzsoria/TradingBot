# =====================================================================
#  TradingBot - configuración de arranque
#
#  scripts/run.ps1 lee este fichero al arrancar (y la propia app también,
#  si se lanza de otra forma). Formato: CLAVE=valor, una por línea.
#  Lo que empieza por # es un comentario.
#
#  Cada bloque corresponde a una skill o parte del bot, y sus claves
#  empiezan por el nombre de ese bloque (UI_..., FEED_..., BIAS_...).
#
#  Una clave vacía, comentada o borrada usa el valor por defecto del
#  código, que aparece entre paréntesis al final de su comentario.
#  Las opciones de la línea de comandos (--demo, --profile, --symbol,
#  --timeframe, --theme) mandan sobre este fichero solo para esa vez.
#
#  No pongas aquí contraseñas: las cuentas de MT5 van en
#  C:\Users\claude\mt5\.env
# =====================================================================

# ---------------------------------------------------------------------
#  APP - arranque
# ---------------------------------------------------------------------
# Traer el código nuevo de GitHub (git pull) antes de arrancar: true / false
APP_AUTO_UPDATE=true

# Perfil de MT5 con el que conectar: el <NOMBRE> de MT5_<NOMBRE>_LOGIN en
# C:\Users\claude\mt5\.env (demo, real...).
# (vacío = el que indique MT5_DEFAULT en ese fichero)
APP_PROFILE=

# Modo demo: datos sintéticos, sin conectar con MT5: true / false   (false)
APP_DEMO=false

# ---------------------------------------------------------------------
#  FEED - conexión con MT5 y velas
# ---------------------------------------------------------------------
# Mercado que se carga al arrancar. Nombre EXACTO del broker, con sus
# mayúsculas y sufijos (p. ej. NAS100FT.r); en MT5: Ver > Símbolos.   (NAS100)
FEED_SYMBOL=NAS100.r

# Timeframe al arrancar: M1 M3 M5 M15 H1 H3 H4 H7 H12 1D 1W   (M15)
FEED_TIMEFRAME=M15

# Tope de seguridad de velas a cargar por mercado y timeframe.   (2000000)
FEED_MAX_BARS=2000000

# ---------------------------------------------------------------------
#  QUOTES - cotizaciones del panel Quotes y cifras de la cuenta
# ---------------------------------------------------------------------
# Cada cuántos segundos se refrescan (admite decimales: 0.5).   (1)
QUOTES_INTERVAL=1

# Desfase del servidor del broker respecto a UTC, en horas, para mostrar
# la hora de Nueva York. Vacío = el bot lo detecta solo con los ticks.
# Fíjalo solo si no lo detecta bien (PC con la hora desincronizada):
# Vantage en verano 3, en invierno 2 (hay que cambiarlo en cada cambio
# de horario).   (vacío)
QUOTES_SERVER_UTC_OFFSET=

# ---------------------------------------------------------------------
#  BIAS - sesgo de la sesión del día en curso
#    Bullish -> solo Long; Bearish -> solo Short; No Bias -> ambas.
#    Cada regla vota +1 (alcista), -1 (bajista) o 0 (sin opinión).
# ---------------------------------------------------------------------
# Reglas activas, separadas por comas. Disponibles:
#   prev_day_break    precio fuera del rango del día anterior
#   tdo               precio por encima/debajo del TDO (True Day Open:
#                     apertura del día de trading, 18:00 NY en índices
#                     americanos y 17:00 en el resto)
#   midnight          precio por encima/debajo de la apertura de las
#                     00:00 NY (no vota hasta que existe esa vela)
#   above_below_open  apertura del día por fecha del servidor (el TDO la
#                     sustituye: no las actives juntas, contarían doble)
#   htf_sweep         barrido de la vela anterior: el sesgo de la vela
#                     actual (H3 en índices, H4 en el resto) sale de las
#                     dos anteriores. Si la n-1 barrió el High de la n-2 y
#                     cerró dentro de su rango -> bajista; si barrió el
#                     Low y cerró dentro -> alcista; si no, no puntúa.
#                     (opcional: aún por medir, no está activa por defecto)
#   htf_break         continuación de la vela anterior (mismas velas que
#                     htf_sweep): si la n-1 cierra por encima del High de
#                     la n-2 -> alcista; si cierra por debajo del Low de la
#                     n-2 -> bajista; si cierra dentro, no puntúa.
#                     (opcional: aún por medir, no está activa por defecto)
#   sma               precio frente a la SMA del gráfico (botón SMA, 30
#                     periodos por defecto, velas del timeframe visible):
#                     por encima -> alcista; por debajo -> bajista.
#                     (opcional, no está activa por defecto)
# tdo y midnight usan los niveles de la skill Levels.
# "ninguna" = sin reglas (siempre No Bias).
# Por defecto las que mejor salieron en el backtest en M5 (docs/analisis_sesgo):
#   (prev_day_break, tdo, midnight, htf_break)
#BIAS_RULES=above_below_open, htf_sweep, htf_break, sma
BIAS_RULES=htf_sweep, htf_break, sma
#BIAS_RULES=prev_day_break, tdo, midnight, htf_sweep, htf_break
#BIAS_RULES=prev_day_break, tdo, midnight, htf_break
#BIAS_RULES=prev_day_break, tdo, midnight
#BIAS_RULES=tdo, midnight, htf_sweep, htf_break

# Puntuación mínima para que haya sesgo: suma de voto x peso de las
# reglas. Bullish con +MIN_SCORE o más, Bearish con -MIN_SCORE o menos.   (3)
#BIAS_MIN_SCORE=2.5
#BIAS_MIN_SCORE=3.5
BIAS_MIN_SCORE=3
#BIAS_MIN_SCORE=2

# Filtro de lateralidad: sin sesgo (No Bias) si el precio apenas avanzó en
# las últimas horas. Eficiencia = |cierre final - cierre inicial| / suma de
# |cambios| de la ventana: 0 = fue y volvió (lateral), 1 = línea recta.
# BIAS_LATERAL_HOURS = ventana en horas (0 = sin filtro);
#BIAS_LATERAL_MIN_EFFICIENCY=eficiencia mínima para tener sesgo.   (6 / 0.15)
BIAS_LATERAL_HOURS=6
BIAS_LATERAL_MIN_EFFICIENCY=0.15

# true: solo hay sesgo si TODAS las reglas activas votan lo mismo.   (false)
BIAS_REQUIRE_ALL=false

# Parámetros de cada regla: BIAS_<REGLA>_<PARÁMETRO>=valor.
# tdo, midnight, above_below_open: zona neutra alrededor del nivel, en %.   (0)
BIAS_TDO_TOLERANCE_PCT=0
BIAS_MIDNIGHT_TOLERANCE_PCT=0
BIAS_ABOVE_BELOW_OPEN_TOLERANCE_PCT=0

# htf_sweep y htf_break: tamaño de las velas, en horas, en índices americanos y en el
# resto. Las velas se alinean con el inicio del día de trading en NY
# (18:00 en índices, 17:00 en el resto).   (3 / 4)
BIAS_HTF_SWEEP_INDEX_HOURS=3
BIAS_HTF_SWEEP_HOURS=4

# Peso de cada regla en la puntuación: BIAS_<REGLA>_WEIGHT.
# Ruptura del día anterior (estructura) 2; TDO 2; Midnight y apertura 1.
#   (2 / 2 / 1 / 1; htf_sweep, htf_break y sma, 2)
BIAS_PREV_DAY_BREAK_WEIGHT=2
BIAS_TDO_WEIGHT=2
BIAS_MIDNIGHT_WEIGHT=1
BIAS_ABOVE_BELOW_OPEN_WEIGHT=1
BIAS_HTF_SWEEP_WEIGHT=2
BIAS_HTF_BREAK_WEIGHT=2
BIAS_SMA_WEIGHT=2

# Recálculo programado del sesgo, en horas, alineado con el inicio del
# día de trading (hora de NY). Índices americanos (día 18:00): cada 3 h;
# resto de activos (día 17:00): cada 4 h. 0 = solo al cargar velas.   (3 / 4)
BIAS_RECALC_INDEX_HOURS=3
BIAS_RECALC_HOURS=4

# ---------------------------------------------------------------------
#  TBR - zonas horarias (Time-Based Ranges) del botón TBR del gráfico
#    Todas en hora de Nueva York. Cada zona es una caja de su Low a su
#    High, con su color muy transparente; al terminar, su High, Low y
#    50 % (punteado) salen de la caja hasta que una vela los toca.
# ---------------------------------------------------------------------
# Botón TBR activado al arrancar: true / false   (false)
TBR_SHOW=false

# Cuántos días naturales hacia atrás se dibujan (también limita hasta dónde
# llegan los fibos y entradas de Pattern; más días = más TBR que estudiar,
# pero el cálculo tarda algo más).   (10; aquí 60)
TBR_DAYS=60

# Opacidad del relleno de las zonas, en % (0 invisible, 100 opaco).
# Valores bajos (10-15) dejan ver las velas a través: efecto traslúcido.   (12)
TBR_OPACITY=12

# Opacidad de las líneas High, Low y 50 % de cada zona, en %.   (60)
TBR_LINE_OPACITY=60

# Timeframe máximo, en minutos, con el que se dibujan (60 = hasta H1).   (60)
TBR_MAX_TF_MINUTES=60

# Zonas activas y su orden. Para una zona nueva, añade su clave aquí y
# sus líneas TBR_<CLAVE>_NAME/_HOURS/_COLOR. De momento solo Asia, London
# y NY Open (las zonas Pre-NY y NY-PM siguen definidas más abajo, por si
# quieres volver a activarlas añadiendo PRE_NY / NY_PM a esta lista).
#   (ASIA, LONDON, NY_AM)
TBR_ZONES=ASIA, LONDON, NY_AM
#TBR_ZONES=ASIA, LONDON, PRE_NY, NY_AM, NY_PM

# Cada zona: nombre en el gráfico, horario NY (HH:MM-HH:MM; si el final es
# anterior al inicio, termina al día siguiente) y color #RRGGBB.
# Asia: 20:00-00:00, amarillo.   (Asia, 20:00-00:00, #FFD60A)
TBR_ASIA_NAME=Asia
TBR_ASIA_HOURS=20:00-00:00
TBR_ASIA_COLOR=#FFD60A

# London: 02:00-05:00, rojo.   (London, 02:00-05:00, #FF3B30)
TBR_LONDON_NAME=London
TBR_LONDON_HOURS=02:00-05:00
TBR_LONDON_COLOR=#FF3B30

# Pre-NY (RHT): 09:00-10:00, gris. Desactivada por ahora.   (Pre-NY, 09:00-10:00, #9E9E9E)
TBR_PRE_NY_NAME=Pre-NY
TBR_PRE_NY_HOURS=09:00-10:00
TBR_PRE_NY_COLOR=#9E9E9E

# NY Open: 10:00-12:00, verde.   (NY Open, 10:00-12:00, #00C853)
TBR_NY_AM_NAME=NY Open
TBR_NY_AM_HOURS=10:00-12:00
TBR_NY_AM_COLOR=#00C853

# NY-PM: 13:30-16:30, morado. Desactivada por ahora.   (NY-PM, 13:30-16:30, #A64DFF)
TBR_NY_PM_NAME=NY-PM
TBR_NY_PM_HOURS=13:30-16:30
TBR_NY_PM_COLOR=#A64DFF

# ---------------------------------------------------------------------
#  LEVELS - niveles del día y separadores (botones TDO, Midnight, PDH/PDL)
#    El día de trading empieza a una hora de NY que depende del activo
#    (ver LEVELS_DAY_START) y lleva el nombre del día en que termina.
#    TDO      True Day Open: open de la primera vela del día de trading
#    Midnight open de la vela de las 00:00 de Nueva York
#    PDH/PDL  máximo y mínimo del día de trading anterior
#    Cada nivel llega hasta el final de su día (el de hoy, algo más allá
#    de la última vela). El nombre del día va centrado entre separadores.
# ---------------------------------------------------------------------
# Inicio del día de trading (separador y TDO), en hora de NY, HH:MM.
# Índices americanos y resto de activos.   (18:00 y 17:00)
LEVELS_INDEX_DAY_START=18:00
LEVELS_DAY_START=17:00

# Qué símbolos son índices americanos: inicios de nombre, separados por
# comas (sin distinguir mayúsculas; NAS100 vale para NAS100.r y NAS100FT.r).
#   (NAS100, SP500, DJ30, US30, US100, US500, USTEC, US2000, SPX500, NDX100)
LEVELS_US_INDICES=NAS100, SP500, DJ30, US30, US100, US500, USTEC, US2000, SPX500, NDX100

# Botones activados al arrancar: true / false   (false)
LEVELS_SHOW_TDO=false
LEVELS_SHOW_MIDNIGHT=false
LEVELS_SHOW_PDHL=false
LEVELS_SHOW_SMA=false

# Líneas punteadas verticales al empezar cada día, con su nombre.   (true)
LEVELS_SEPARATORS=true

# Cuántos días de trading hacia atrás llevan niveles.   (10)
LEVELS_DAYS=10

# Timeframe máximo, en minutos, con el que se dibujan (720 = hasta H12).   (720)
LEVELS_MAX_TF_MINUTES=720

# Cierre de los mercados, hora de NY, HH:MM: avisa en el Registro cuando cierran
# los futuros de índices USA (cada día laborable) y Forex (el viernes).   (17:00)
LEVELS_MARKET_CLOSE=17:00

# Colores #RRGGBB.   (TDO #787B86, Midnight #FF9800, PDH/PDL #2962FF,
# separadores #787B86)
LEVELS_TDO_COLOR=#787B86
LEVELS_MIDNIGHT_COLOR=#FF9800
LEVELS_PDHL_COLOR=#2962FF
LEVELS_SEPARATOR_COLOR=#787B86

# SMA: media móvil simple de los cierres (botón SMA, a la izquierda de TDO; clic
# derecho o el botón de la rueda para configurarla). Usa las velas del timeframe que se está
# viendo.   (30 periodos, color #00ACC1, trazo normal)
#   LEVELS_SMA_STYLE: normal, discontinuo o punteado
LEVELS_SMA_PERIOD=30
LEVELS_SMA_COLOR=#FFFF00
#LEVELS_SMA_COLOR=#0000FF
#LEVELS_SMA_COLOR=#00ACC1
LEVELS_SMA_STYLE=punteado
#LEVELS_SMA_STYLE=discontinuo
#LEVELS_SMA_STYLE=normal

# ---------------------------------------------------------------------
#  PATTERN - patrones dentro de la TBR activa (la última TBR cerrada)
#    La skill Pattern se conecta a TBR: la TBR activa es la última que ha
#    cerrado, con su High, Low y 50 %. Busca ahí los patrones de entrada
#    definidos y anota en el Registro cada uno que identifica. Después
#    Cortex los valida con el sesgo (ver bloque CORTEX).
# ---------------------------------------------------------------------
# Patrones que se buscan, por su clave. Vacío: todos los definidos.
#   continuacion   rotura con cuerpo (cierre) del High o el Low de la TBR en
#                  M15: se dibuja el fibonacci (0, 0,5 y 1) desde el swing
#                  previo y la entrada es la reversión al 0,5.
#                  Ver skills/pattern/continuacion.py.
#   reversion      toma de un lado de la TBR solo con la mecha en M15: el
#                  fibonacci va de la mecha pivote al pivote que genera a
#                  continuación; entrada en el 0,5, stop en la mecha y
#                  objetivo en 2R. Ver skills/pattern/reversion.py.
PATTERN_TYPES=

# Días hacia atrás de TBR pasadas de las que se dibujan los fibos y las
# entradas (botones Fibo y Entradas) para estudiar su comportamiento. Solo
# se dibujan: no generan avisos ni órdenes. No pasa de TBR_DAYS. 1 = solo
# las TBR activas.   (30; aquí 60)
PATTERN_HISTORY_DAYS=60

# Zonas TBR en las que se buscan, por su clave (p. ej. LONDON, NY_AM).
# Vacío: todas las de TBR_ZONES.   (vacío)
PATTERN_ZONES=

# Botón «Fibo» del gráfico activado al arrancar: dibuja el fibonacci del
# patrón continuacion: true / false   (true)
PATTERN_SHOW_FIBO=true

# Botón «Entradas» del gráfico activado al arrancar: dibuja cada entrada
# como la herramienta de posición de TradingView (zona verde hasta el
# objetivo, zona roja hasta el stop): true / false   (true)
PATTERN_SHOW_POSITIONS=true

# Patrón continuacion. Se evalúa siempre con velas de este timeframe, sea
# cual sea el del gráfico (M15, o M1/M3/M5 agrupado en M15).   (15m)
PATTERN_CONTINUACION_TF=15m

# Velas a cada lado que definen un swing (pivote): 1 = patrón de tres velas
# (el máximo más alto, o el mínimo más bajo, en la del medio). El swing
# previo a la rotura es el último pivote.   (1)
PATTERN_CONTINUACION_SWING_BARS=1

# Patrón reversion: timeframe (se evalúa siempre con velas de este
# timeframe) y velas a cada lado de un pivote (1 = tres velas).   (15m / 1)
PATTERN_REVERSION_TF=15m
PATTERN_REVERSION_SWING_BARS=1

# Ciclo de TBR, en orden, que fija el plazo de cada patrón: se buscan hasta
# que empieza la TBR siguiente (Asia hasta London, London hasta NY Open y
# NY Open hasta NY PM). Tras NY PM no se evalúan más setups: se anota en el
# Registro. NY PM solo marca el límite; si algún día se trabaja, añadir
# ASIA al final del plazo de NY PM.   (ASIA, LONDON, NY_AM, NY_PM)
PATTERN_ZONE_ORDER=ASIA, LONDON, NY_AM, NY_PM

# TBR cuyo plazo se amplía hasta el final de la última zona del ciclo (NY PM).
# Se aplica solo si la zona no está en PATTERN_UNTIL, que tiene prioridad.
# Vacío: ninguna.   (vacío)
PATTERN_EXTEND=

# Hasta cuándo se buscan setups en cada TBR (por defecto, hasta el inicio de
# la TBR siguiente del ciclo). Una entrada por zona, separadas por comas:
#   ZONA:ZONA       hasta el inicio de otra zona (ASIA:NY_AM: Asia hasta las 10:00)
#   ZONA:ZONA:FIN   hasta el final de otra zona (LONDON:NY_AM:FIN: hasta las 12:00)
#   ZONA@HH:MM      hasta una hora fija de NY (ASIA@05:00: Asia hasta las 05:00;
#                   NY_AM@18:00: NY Open hasta las 18:00,
#                   el inicio del nuevo día de trading de los índices)
# Vacío: ninguna.   (LONDON:NY_AM:FIN, NY_AM@18:00; Asia hasta London)
PATTERN_UNTIL=LONDON:NY_AM:FIN, NY_AM@18:00

# ---------------------------------------------------------------------
#  CORTEX - coordinador
#    Reúne activo, temporalidad, sesgo, TBR activa y patrón. Cuando Pattern
#    identifica el patrón de entrada, lo contrasta con el sesgo (reglas de
#    Bias): Bullish solo permite Long y Bearish solo Short (GO); en contra,
#    sin sesgo o con el mercado lateral, NO GO. Con GO, le pasa la orden a
#    la skill Setup, que es la única que opera.
# ---------------------------------------------------------------------
# true: con No Bias (sin sesgo claro) también se da GO.   (false)
CORTEX_ALLOW_NO_BIAS=true

# Posiciones abiertas a la vez (simuladas): hasta que la abierta cierre por
# stop, objetivo o tiempo (24 h) no se da otra orden.
#   global   una sola en toda la cuenta (todos los mercados)
#   mercado  una por mercado
# (global)
CORTEX_POSITION_SCOPE=global

# true: la estrategia Calendario también debe ir a favor del sesgo (el
# backtest no lo usa: los largos de lunes no mejoran con el sesgo).   (false)
CORTEX_CALENDAR_USE_BIAS=false

# ---------------------------------------------------------------------
#  CALENDARIO - estrategia de calendario (sin patrones)
#    Largos a hora fija en los días elegidos (por defecto, lunes de
#    madrugada). Backtest 2018-2026 (scripts/lunes_hora_fija.py): la deriva
#    alcista nocturna de los índices da ~+0,07 % por operación. Avisa a
#    Cortex, que le da la orden a Setup (solo simulación). Hora de Nueva York.
# ---------------------------------------------------------------------
# Mercados donde opera (el nombre empieza como el del broker).   (NAS100, DJ30)
CALENDARIO_SYMBOLS=NAS100, DJ30

# Días: lunes, martes, miercoles, jueves, viernes.   (lunes)
CALENDARIO_DAYS=lunes

# Hora de entrada (apertura de la vela) y de cierre por tiempo, HH:MM NY.
# Necesita un timeframe de 60 min o menos.   (02:00 / 10:00)
CALENDARIO_ENTRY_HOUR=02:00
CALENDARIO_EXIT_HOUR=10:00

# Stop como % del precio y objetivo como múltiplo del stop.   (0.5 / 2)
CALENDARIO_STOP_PCT=0.5
CALENDARIO_RR=2

# ---------------------------------------------------------------------
#  SETUP - ejecutor
#    Solo actúa cuando Cortex le da una orden: la mete en la cuenta del
#    broker. Por ahora funciona en modo simulación: la orden se prepara y
#    se anota en el Registro, pero NO se envía a MT5.
# ---------------------------------------------------------------------
# true: enviar las órdenes a MT5 (aún no implementado: da error).   (false)
SETUP_SEND_ORDERS=false

# ---------------------------------------------------------------------
#  STATS - forwardtest y backtest
#    Reúne lo que hace el bot desde que opera (GO / NO GO de Cortex y
#    operaciones simuladas de Setup: botón Forwardtest) y los resultados
#    del backtest de los patrones (botón Backtest). No opera ni decide nada.
# ---------------------------------------------------------------------
# Carpeta del diario del forwardtest: un fichero por mes (AAAA-MM.jsonl)
# que no se borra al reiniciar. Vacío: data/forwardtest   ()
STATS_FORWARD_DIR=

# Resumen del backtest que se muestra. Vacío: el de la skill
# (tradingbot/skills/stats/backtest.json, que se regenera con
# scripts/exportar_backtest.py).   ()
STATS_BACKTEST_FILE=

# ---------------------------------------------------------------------
#  UI - interfaz
# ---------------------------------------------------------------------
# Paleta de colores al arrancar (ver screenshots/<nombre>.png).
# Deja activa una sola línea; las demás, comentadas con #.
UI_THEME=matrix
#UI_THEME=negro
#UI_THEME=pizarra
#UI_THEME=blanco
