# =====================================================================
#  TradingBot - configuración de arranque
#
#  scripts/run.ps1 lee este fichero al arrancar (y la propia app también,
#  si se lanza de otra forma). Formato: CLAVE=valor, una por línea.
#  Lo que empieza por # es un comentario.
#
#  Cada bloque corresponde a una skill o parte del bot, y sus claves
#  empiezan por el nombre de ese bloque (UI_..., FEED_..., BIAS_...).
#
#  Una clave vacía, comentada o borrada usa el valor por defecto del
#  código, que aparece entre paréntesis al final de su comentario.
#  Las opciones de la línea de comandos (--demo, --profile, --symbol,
#  --timeframe, --theme) mandan sobre este fichero solo para esa vez.
#
#  No pongas aquí contraseñas: las cuentas de MT5 van en
#  C:\Users\claude\mt5\.env
# =====================================================================

# ---------------------------------------------------------------------
#  APP - arranque
# ---------------------------------------------------------------------
# Traer el código nuevo de GitHub (git pull) antes de arrancar: true / false
APP_AUTO_UPDATE=true

# Perfil de MT5 con el que conectar: el <NOMBRE> de MT5_<NOMBRE>_LOGIN en
# C:\Users\claude\mt5\.env (demo, real...).
# (vacío = el que indique MT5_DEFAULT en ese fichero)
APP_PROFILE=

# Modo demo: datos sintéticos, sin conectar con MT5: true / false   (false)
APP_DEMO=false

# ---------------------------------------------------------------------
#  FEED - conexión con MT5 y velas
# ---------------------------------------------------------------------
# Mercado que se carga al arrancar. Nombre EXACTO del broker, con sus
# mayúsculas y sufijos (p. ej. NAS100FT.r); en MT5: Ver > Símbolos.   (EURUSD)
FEED_SYMBOL=EURUSD

# Timeframe al arrancar: M1 M3 M5 M15 H1 H3 H4 H7 H12 1D 1W   (M15)
FEED_TIMEFRAME=M15

# Tope de seguridad de velas a cargar por mercado y timeframe.   (2000000)
FEED_MAX_BARS=2000000

# ---------------------------------------------------------------------
#  QUOTES - cotizaciones del panel Mercados y cifras de la cuenta
# ---------------------------------------------------------------------
# Cada cuántos segundos se refrescan (admite decimales: 0.5).   (1)
QUOTES_INTERVAL=1

# Desfase del servidor del broker respecto a UTC, en horas, para mostrar
# la hora de Nueva York. Vacío = el bot lo detecta solo con los ticks.
# Fíjalo solo si no lo detecta bien (PC con la hora desincronizada):
# Vantage en verano 3, en invierno 2 (hay que cambiarlo en cada cambio
# de horario).   (vacío)
QUOTES_SERVER_UTC_OFFSET=

# ---------------------------------------------------------------------
#  BIAS - sesgo de la sesión del día en curso
#    Bullish -> solo Long; Bearish -> solo Short; No Bias -> ambas.
#    Cada regla vota +1 (alcista), -1 (bajista) o 0 (sin opinión).
# ---------------------------------------------------------------------
# Reglas activas, separadas por comas. Disponibles (son EJEMPLOS):
#   prev_day_break    precio fuera del rango del día anterior
#   above_below_open  precio por encima/debajo de la apertura del día
# "ninguna" = sin reglas (siempre No Bias).   (prev_day_break, above_below_open)
BIAS_RULES=prev_day_break, above_below_open

# Votos mínimos en una dirección para que haya sesgo.   (1)
BIAS_MIN_VOTES=1

# true: solo hay sesgo si TODAS las reglas activas votan lo mismo.   (false)
BIAS_REQUIRE_ALL=false

# Parámetros de cada regla: BIAS_<REGLA>_<PARÁMETRO>=valor.
# above_below_open: zona neutra alrededor de la apertura, en %.   (0)
BIAS_ABOVE_BELOW_OPEN_TOLERANCE_PCT=0

# ---------------------------------------------------------------------
#  TBR - zonas horarias (Time-Based Ranges) del botón TBR del gráfico
#    Todas en hora de Nueva York. Cada zona es una caja de su Low a su
#    High, con su color muy transparente; al terminar, su High, Low y
#    50 % (punteado) salen de la caja hasta que una vela los toca.
# ---------------------------------------------------------------------
# Botón TBR activado al arrancar: true / false   (false)
TBR_SHOW=false

# Cuántos días naturales hacia atrás se dibujan.   (10)
TBR_DAYS=10

# Opacidad del relleno de las zonas, en % (0 invisible, 100 opaco).   (25)
TBR_OPACITY=25

# Timeframe máximo, en minutos, con el que se dibujan (60 = hasta H1).   (60)
TBR_MAX_TF_MINUTES=60

# Zonas activas y su orden. Para una zona nueva, añade su clave aquí y
# sus líneas TBR_<CLAVE>_NAME/_HOURS/_COLOR.
#   (ASIA, LONDON, PRE_NY, NY_AM, NY_PM)
TBR_ZONES=ASIA, LONDON, PRE_NY, NY_AM, NY_PM

# Cada zona: nombre en el gráfico, horario NY (HH:MM-HH:MM; si el final es
# anterior al inicio, termina al día siguiente) y color #RRGGBB.
# Asia: 20:00-00:00, amarillo.   (Asia, 20:00-00:00, #FFD60A)
TBR_ASIA_NAME=Asia
TBR_ASIA_HOURS=20:00-00:00
TBR_ASIA_COLOR=#FFD60A

# London: 02:00-05:00, rojo.   (London, 02:00-05:00, #FF3B30)
TBR_LONDON_NAME=London
TBR_LONDON_HOURS=02:00-05:00
TBR_LONDON_COLOR=#FF3B30

# Pre-NY: 09:00-10:00, gris.   (Pre-NY, 09:00-10:00, #9E9E9E)
TBR_PRE_NY_NAME=Pre-NY
TBR_PRE_NY_HOURS=09:00-10:00
TBR_PRE_NY_COLOR=#9E9E9E

# NY-AM: 10:00-12:00, verde.   (NY-AM, 10:00-12:00, #00C853)
TBR_NY_AM_NAME=NY-AM
TBR_NY_AM_HOURS=10:00-12:00
TBR_NY_AM_COLOR=#00C853

# NY-PM: 13:30-16:30, morado.   (NY-PM, 13:30-16:30, #A64DFF)
TBR_NY_PM_NAME=NY-PM
TBR_NY_PM_HOURS=13:30-16:30
TBR_NY_PM_COLOR=#A64DFF

# ---------------------------------------------------------------------
#  LEVELS - niveles del día y separadores (botones TDO, Midnight, PDH/PDL)
#    El día es el de trading del broker (en Vantage empieza a las 17:00
#    de NY y su primera vela, a las 18:00, es la apertura del mercado).
#    TDO      apertura del mercado: open de la primera vela del día
#    Midnight open de la vela de las 00:00 de Nueva York
#    PDH/PDL  máximo y mínimo del día de trading anterior
#    Cada nivel llega hasta el final de su día (el de hoy, algo más allá
#    de la última vela).
# ---------------------------------------------------------------------
# Botones activados al arrancar: true / false   (false)
LEVELS_SHOW_TDO=false
LEVELS_SHOW_MIDNIGHT=false
LEVELS_SHOW_PDHL=false

# Líneas punteadas verticales al empezar cada día, con su nombre.   (true)
LEVELS_SEPARATORS=true

# Cuántos días de trading hacia atrás llevan niveles.   (10)
LEVELS_DAYS=10

# Timeframe máximo, en minutos, con el que se dibujan (720 = hasta H12).   (720)
LEVELS_MAX_TF_MINUTES=720

# Colores #RRGGBB.   (TDO #787B86, Midnight #FF9800, PDH/PDL #2962FF,
# separadores #787B86)
LEVELS_TDO_COLOR=#787B86
LEVELS_MIDNIGHT_COLOR=#FF9800
LEVELS_PDHL_COLOR=#2962FF
LEVELS_SEPARATOR_COLOR=#787B86

# ---------------------------------------------------------------------
#  UI - interfaz
# ---------------------------------------------------------------------
# Paleta de colores al arrancar (ver screenshots/<nombre>.png).
# Deja activa una sola línea; las demás, comentadas con #.
UI_THEME=matrix
#UI_THEME=negro
#UI_THEME=pizarra
#UI_THEME=blanco
