# =====================================================================
#  TradingBot - configuración de arranque
#
#  scripts/run.ps1 lee este fichero al arrancar (y la propia app también,
#  si se lanza de otra forma). Formato: CLAVE=valor, una por línea.
#  Lo que empieza por # es un comentario.
#
#  Cada bloque corresponde a una skill o parte del bot, y sus claves
#  empiezan por el nombre de ese bloque (UI_..., FEED_..., BIAS_...).
#
#  No pongas aquí contraseñas: las cuentas de MT5 van en
#  C:\Users\claude\mt5\.env
# =====================================================================

# ---------------------------------------------------------------------
#  APP - arranque
# ---------------------------------------------------------------------
# Traer el código nuevo de GitHub (git pull) antes de arrancar: true / false
APP_AUTO_UPDATE=true

# ---------------------------------------------------------------------
#  UI - interfaz
# ---------------------------------------------------------------------
# Paleta de colores al arrancar (ver screenshots/<nombre>.png).
# Deja activa una sola línea; las demás, comentadas con #.
UI_THEME=matrix
#UI_THEME=negro
#UI_THEME=pizarra
#UI_THEME=blanco
