# Plantilla del fichero de cuentas. El real vive FUERA del repo:
#   C:\Users\claude\mt5\.env
# Perfil por defecto si no se indica --profile
MT5_DEFAULT=demo

# Opcional: ruta al terminal (terminal64.exe). Si no se indica, MT5 lo localiza solo.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Un bloque por cuenta (perfil): MT5_<PERFIL>_LOGIN / _SERVER / _PASSWORD
# Opcionales: _NAME (nombre en el selector de la cabecera) y _PATH (terminal
# propio de ese broker; si falta, MT5_PATH o el que encuentre MT5).
# _SYMBOLS: nombre del broker para un mercado del bot, si no lo encuentra solo
# (el bot ya prueba sufijos como NAS100.s y otros nombres como CL-OIL.s).
MT5_DEMO_LOGIN=12345678
MT5_DEMO_SERVER=NombreDelServidor-Demo
# MT5_DEMO_NAME=Broker-Demo
# MT5_DEMO_PATH=C:\Program Files\Broker MT5\terminal64.exe
# MT5_DEMO_SYMBOLS=NAS100=NAS100ft.s, USOIL=CL-OIL.s
# La contraseña es opcional: si falta, se usa la variable de entorno
# MT5_DEMO_PASSWORD o se aprovecha la sesión ya abierta en el terminal.
MT5_DEMO_PASSWORD=
